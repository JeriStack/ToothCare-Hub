# ToothCare Hub — Isolated Test Environment Template (.env.testing.example)
# Copy to .env.testing for local MySQL integration testing.
# NEVER point automated tests at production databases or live SMTP servers.

APP_ENV=testing
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Isolated Test Database (SQLite in-memory by default in PHPUnit; set mysql for real MySQL 8.0 integration runs)
TEST_DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=toothcare_test
DB_USER=root
DB_PASSWORD=ci_test_password_change_me

# Mail Transport (ALWAYS disabled / fake transport during automated tests)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@test.toothcare.local
EMAIL_PAYLOAD_KEY=test-only-not-a-production-secret-key

# Real-Time Socket.IO Service (isolated test secret; disabled during unit tests)
REALTIME_ENABLED=false
REALTIME_INTERNAL_URL=http://127.0.0.1:4000
REALTIME_INTERNAL_SECRET=test-only-realtime-hmac-secret-at-least-32-chars

# Playwright E2E
PLAYWRIGHT_PORT=5174
PLAYWRIGHT_LIVE_API=false
