# =============================================================================
# ToothCare Hub — Production HTTPS / WSS TLS Termination Template (Phase 20)
# Mount as /etc/nginx/conf.d/default.conf in production ONLY after valid CA
# certificates are provisioned at /etc/nginx/ssl/fullchain.pem & privkey.pem.
# Never commit private keys or copy certificates into Docker images.
# =============================================================================

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    # Allow ACME HTTP-01 challenge renewal before HTTPS redirect
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"healthy","service":"toothcare-nginx"}\n';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    # Enable HSTS ONLY after confirming HTTPS works cleanly on the target domain
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;

    root /var/www/frontend/dist;
    index index.html;
    charset utf-8;
    autoindex off;
    server_tokens off;

    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ^~ /api/v1/internal/ { deny all; return 403; }
    location = /api/v1/metrics    { deny all; return 403; }
    location = /stub_status       { deny all; return 403; }

    location /api/ {
        client_max_body_size 5m;
        fastcgi_pass php_fpm_backend;
        include /etc/nginx/snippets/fastcgi-params.conf;
        fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param DOCUMENT_ROOT /var/www/backend/public;
        fastcgi_param HTTPS on;
    }

    location /socket.io/ {
        proxy_pass http://realtime_service;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
