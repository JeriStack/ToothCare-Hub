# =============================================================================
# ToothCare Hub - Real-Time Service (Node.js + TypeScript + Socket.IO)
# Copy to realtime/.env for local development.
# NEVER commit realtime/.env or production secrets to Git.
# =============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Internal PHP API URL reachable over the private Docker network (internal port 8081 on nginx)
BACKEND_INTERNAL_API_URL=http://nginx:8081

# Shared HMAC-SHA256 secret (minimum 32 chars required in production)
REALTIME_INTERNAL_SECRET=CHANGE_ME_GENERATE_32_BYTE_HEX_SECRET

# Security & Operational Controls
SOCKET_PATH=/socket.io/
REPLAY_WINDOW_SECONDS=300
SESSION_REVALIDATE_INTERVAL_MS=60000
PUBLISH_RATE_LIMIT_PER_MIN=600
MAX_CONNECTIONS_PER_USER=10
EVENT_DEDUP_TTL_MS=300000
EVENT_DEDUP_MAX_SIZE=10000
LOG_LEVEL=info
