{
  "name": "toothcare-hub-realtime",
  "version": "1.0.0",
  "private": true,
  "description": "ToothCare Hub Real-Time Notification Service (Node.js + TypeScript + Socket.IO)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsc -w --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
