      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 14, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "toothcare_email_jobs_pending{job=\"toothcare-api\"}", "legendFormat": "pending" },
