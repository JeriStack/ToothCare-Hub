{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "API request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"toothcare-backend\"}[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "title": "Realtime connected clients",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "socket_io_connected{job=\"toothcare-realtime\"}",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "title": "Email outbox queue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "toothcare_email_jobs_pending{job=\"toothcare-api\"}", "legendFormat": "pending" },
        { "expr": "toothcare_email_worker_processing{job=\"toothcare-api\"}", "legendFormat": "processing" },
        { "expr": "toothcare_email_jobs_exhausted{job=\"toothcare-api\"}", "legendFormat": "exhausted" }
      ]
    },
    {
      "title": "Email deliveries and failures (per 15m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(increase(toothcare_email_delivery_success_total{job=\"toothcare-api\"}[15m]))", "legendFormat": "delivered" },
        { "expr": "sum by (category) (increase(toothcare_email_delivery_failure_total{job=\"toothcare-api\"}[15m]))", "legendFormat": "failed {{category}}" },
        { "expr": "sum(increase(toothcare_email_retry_total{job=\"toothcare-api\"}[15m]))", "legendFormat": "retries" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["toothcare"],
  "title": "ToothCare Hub - Overview",
  "version": 1
}
