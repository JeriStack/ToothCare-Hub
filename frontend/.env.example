# =============================================================================
# ToothCare Hub - Frontend Vite Environment Template (Public Values Only)
# Copy to frontend/.env for local development: Copy-Item frontend/.env.example frontend/.env
# SECURITY WARNING: Any variable prefixed with VITE_ is bundled into browser JS.
# NEVER put database passwords, SMTP credentials, or signing secrets in this file.
# =============================================================================

VITE_APP_NAME="ToothCare Hub"
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SOCKET_URL=http://localhost:8080

# Browserbase Remote Cloud Testing (Used by Playwright test runner in Node.js - Not exposed to browser)
BROWSERBASE_API_KEY=your_browserbase_api_key_placeholder
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_placeholder
