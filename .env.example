# =============================================================================
# ToothCare Hub - Root Environment Template (Placeholders Only)
# Copy to .env for local development: Copy-Item .env.example .env
# NEVER commit real passwords, tokens, or production secrets to Git.
# =============================================================================

# Application & Docker Compose Identity
APP_ENV=development
COMPOSE_PROJECT_NAME=toothcare-hub
APP_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api/v1

# Non-sensitive Host Port Mappings (Docker Compose local overrides)
NGINX_HTTP_PORT=8080
MYSQL_PORT=3306
REALTIME_PORT=4000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Database Container Initialization (Replace placeholders in local .env)
DB_NAME=toothcare_hub
DB_PASSWORD=CHANGE_ME_LOCAL_MYSQL_ROOT_PASSWORD

# Grafana Provisioning Credentials (Change before any shared/staging/prod use)
GRAFANA_ADMIN_USER=admin_placeholder
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
