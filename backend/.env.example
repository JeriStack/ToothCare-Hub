# =============================================================================
# ToothCare Hub - Backend PHP REST API Environment Template (Placeholders Only)
# Copy to backend/.env for local development: Copy-Item backend/.env.example backend/.env
# NEVER commit backend/.env or real credentials to Git.
# =============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
API_BASE_PATH=/api/v1
LOG_LEVEL=debug
REQUEST_BODY_MAX_BYTES=1048576

# Session, Authentication & CSRF Security
SESSION_COOKIE_NAME=toothcare_session
SESSION_LIFETIME=7200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.55:5173
CORS_MAX_AGE=86400

# Password Policy & Token Security (Phase 7)
AUTH_PASSWORD_MIN_LENGTH=8
EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=1800

# Rate Limiting & Abuse Prevention (Phase 7)
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW=900
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW=3600
AUTH_PASSWORD_RESET_RATE_LIMIT=3
AUTH_PASSWORD_RESET_RATE_WINDOW=3600

# Database (MySQL / InnoDB)
# Use DB_HOST=mysql inside Docker Compose; use DB_HOST=127.0.0.1 for host CLI / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toothcare_hub
DB_USERNAME=toothcare_app
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_CHARSET=utf8mb4

# Legacy Database Variable Aliases (Supported by Config)
DB_NAME=toothcare_hub
DB_USER=toothcare_app

# Mail (Transactional SMTP via PHPMailer). Development default targets the Mailpit sink (compose.dev.yaml).
# Production: set real values through your secrets manager, never commit them.
MAIL_ENABLED=true
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# none | tls (STARTTLS, usually 587) | ssl (implicit TLS, usually 465)
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=noreply@toothcarehub.example.invalid
MAIL_FROM_NAME="ToothCare Hub Clinic"
MAIL_REPLY_TO_ADDRESS=
MAIL_TIMEOUT=15
# Never set to false in production (rejected at startup).
MAIL_VERIFY_PEER=true

# Email outbox worker and reminder scheduling
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_ATTEMPTS=5
EMAIL_WORKER_LOCK_TIMEOUT=300
EMAIL_WORKER_SLEEP_SECONDS=5
# Seconds to wait after attempt 1..N (last value repeats), and +/- jitter ratio (0 to 0.5)
EMAIL_RETRY_DELAYS=60,300,900,3600,21600
EMAIL_RETRY_JITTER=0.1
# Default reminder lead time in hours. The clinic setting reminder_lead_hours overrides it.
EMAIL_REMINDER_LEAD_HOURS=24
# Secret used to encrypt verification/reset tokens held in the outbox until sent.
# Required in production. Generate with: php -r "echo bin2hex(random_bytes(32));"
EMAIL_PAYLOAD_KEY=

# Real-Time Service (Internal PHP-to-Node Publishing Channel)
REALTIME_HOST=realtime
REALTIME_PORT=3001
REALTIME_SECRET=CHANGE_ME_GENERATE_32_BYTE_HEX_SECRET

# Database Backup & Disaster Recovery
BACKUP_STORAGE_DIR=/var/www/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_ENCRYPTION_KEY
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_OFFSITE_ENABLED=false
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_KEY_ID=""
BACKUP_S3_SECRET=""
