# =============================================================================
# ToothCare Hub - Backend PHP REST API Environment Template (Placeholders Only)
# Copy to backend/.env for local development: Copy-Item backend/.env.example backend/.env
# NEVER commit backend/.env or real credentials to Git.
# =============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
API_BASE_PATH=/api/v1
LOG_LEVEL=debug
REQUEST_BODY_MAX_BYTES=1048576

# Session, Authentication & CSRF Security
SESSION_COOKIE_NAME=toothcare_session
SESSION_LIFETIME=7200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_MAX_AGE=86400

# Database (MySQL / InnoDB)
# Use DB_HOST=mysql inside Docker Compose; use DB_HOST=127.0.0.1 for host CLI / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toothcare_hub
DB_USERNAME=toothcare_app
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_CHARSET=utf8mb4

# Legacy Database Variable Aliases (Supported by Config)
DB_NAME=toothcare_hub
DB_USER=toothcare_app

# Mail (Transactional SMTP via PHPMailer)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=placeholder_smtp_username
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@toothcarehub.example.invalid
MAIL_FROM_NAME="ToothCare Hub Clinic"

# Real-Time Service (Internal PHP-to-Node Publishing Channel)
REALTIME_HOST=realtime
REALTIME_PORT=3001
REALTIME_SECRET=CHANGE_ME_GENERATE_32_BYTE_HEX_SECRET
