# =============================================================================
# ToothCare Hub - Backend PHP REST API Environment Template (Placeholders Only)
# Copy to backend/.env for local development: Copy-Item backend/.env.example backend/.env
# NEVER commit backend/.env or real credentials to Git.
# =============================================================================

# Application
APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=debug

# Session, Authentication & CSRF Security
SESSION_COOKIE_NAME=toothcare_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
CSRF_TOKEN_TTL_SECONDS=7200
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Database (MySQL / InnoDB)
# Use DB_HOST=mysql inside Docker Compose; use DB_HOST=127.0.0.1 for host CLI / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=toothcare_hub
DB_USER=toothcare_app_placeholder
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# Mail (Transactional SMTP via PHPMailer)
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=placeholder_smtp_username
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@toothcarehub.example.invalid
MAIL_FROM_NAME="ToothCare Hub Clinic"

# Real-Time Service (Internal PHP-to-Node Publishing Channel)
REALTIME_INTERNAL_URL=http://127.0.0.1:4000/internal/publish
REALTIME_INTERNAL_SECRET=CHANGE_ME_GENERATE_32_BYTE_HEX_SECRET
REALTIME_TICKET_TTL_SECONDS=60
