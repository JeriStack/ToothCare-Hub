# Backend environment (placeholders only - never commit real credentials)

# Application
APP_ENV=development
APP_URL=http://localhost/ToothCare-Hub/backend/public

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=toothcare_hub
DB_USER=root
DB_PASSWORD=

# Mail (SMTP via PHPMailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@toothcarehub.local

# Real-time service (internal server-to-server channel)
REALTIME_INTERNAL_URL=http://127.0.0.1:4000/internal/publish
REALTIME_INTERNAL_SECRET=
