{
    "name": "toothcare-hub/backend",
    "description": "ToothCare Hub - native PHP REST API for dental appointment and clinic management.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^7.2",
        "zircote/swagger-php": "^4.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "openapi": "openapi src -o docs/openapi.yaml",
        "openapi:validate": "php scripts/validate-openapi.php",
        "db:seed": "php scripts/seed.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
